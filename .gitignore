mock_cache.db

# Pipeline Raw / Intermediate JSON Outputs
jobs.json
apify_raw.json
cleaned_jobs.json
cleaned_resume.json
output.json
matched_jobs.json
retrieved_jobs.json
rerank_results.json
llm_judge_results.json
results.json

# Orchestration Run Directories & Reports
runs/
report.html
manifest.json

# Sensitive / Personal Fixtures
# Ignore real resumes and downloaded job payloads in the tests folder
tests/fixtures/resumes/*.pdf
tests/fixtures/resumes/*.docx
tests/fixtures/resumes/*.txt
tests/fixtures/jobs/*.json
# (Allow keep files so the directories stay in git)
!tests/fixtures/resumes/.gitkeep
!tests/fixtures/jobs/.gitkeepstorage/
storage/
